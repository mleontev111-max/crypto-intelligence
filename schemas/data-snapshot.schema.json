{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-intelligence.local/schemas/data-snapshot.schema.json",
  "title": "DataSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_snapshot_id","created_at","cutoff_available_at","manifest_hash","components","schema_version"],
  "properties": {
    "data_snapshot_id": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "cutoff_available_at": {"type":"string","format":"date-time","description":"No component may have available_at later than this cutoff."},
    "manifest_hash": {"type":"string","minLength":16},
    "components": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required":["dataset_id","version_or_query_hash","max_available_at"],
        "properties": {
          "dataset_id":{"type":"string","minLength":1},
          "version_or_query_hash":{"type":"string","minLength":1},
          "max_available_at":{"type":"string","format":"date-time"},
          "row_count":{"type":["integer","null"],"minimum":0}
        }
      }
    },
    "notes": {"type":["string","null"]},
    "schema_version": {"type":"string","const":"0.1"}
  }
}